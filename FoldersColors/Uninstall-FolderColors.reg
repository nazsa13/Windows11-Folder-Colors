Windows Registry Editor Version 5.00

; =========================
; Remove context menu entries (current + legacy layouts)
; =========================
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\FolderColorMenu1]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\FolderColorMenu2]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\FolderColorReset]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\FolderColorPicker]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\FolderColorMenu]
[-HKEY_CLASSES_ROOT\Directory\shell\FolderColor1]
[-HKEY_CLASSES_ROOT\Directory\shell\FolderColor2]

; If you ever installed system-wide under HKLM\SOFTWARE\Classes, remove too:
[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\FolderColor1]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\FolderColor2]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\FolderColorPicker]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\FolderColorMenu]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\FolderColorMenu1]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\FolderColorMenu2]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\FolderColorReset]

