[HKEY_CURRENT_USER\Software\Classes\Directory\shell\FolderColorReset]
"MUIVerb"="Reset Folder Color"
"Icon"="shell32.dll,240"
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\FolderColorReset\command]
@="powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"resetPs1Path\" -Folder \"%1\""

