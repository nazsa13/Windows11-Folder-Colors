Windows Registry Editor Version 5.00

; Legacy installer (manual path replacement).
; Recommended: run Install-FolderColors.ps1 instead.
;
; Replace these placeholders with real paths before running:
;   ps1Path     -> full path to Set-FolderIcon.ps1
;   resetPs1Path-> full path to Reset-FolderIcon.ps1
;   iclPath     -> full path to Windows_11_coloured_icons.icl
;                  (ideally the stable %LOCALAPPDATA%\FolderColors copy)
;   MIconPath   -> full path to MenuIcon.ico
;
; Layout notes:
;   FolderColorMenu   = classic cascading submenu with all colors + Reset.
;   (The old one-click GUI picker entry, FolderColorPicker, was removed on purpose.)
;   Uses nested shell subkeys only (no Explorer CommandStore), which works per-user.

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\FolderColorMenu]
"MUIVerb"="Set Folder Color"
"Icon"="MIconPath"
; Must stay EMPTY: a non-empty SubCommands list makes Explorer resolve verbs
; from Explorer\CommandStore (not used here) and yields an empty flyout.
"SubCommands"=""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\FolderColorMenu\shell\DarkGrey]
@="Dark Grey"
"Icon"="iclPath,0"
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\FolderColorMenu\shell\DarkGrey\command]
@="powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"ps1Path\" -Folder \"%1\" -IconIndex 0 -IconPath \"iclPath\""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\FolderColorMenu\shell\Grey]
@="Grey"
"Icon"="iclPath,1"
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\FolderColorMenu\shell\Grey\command]
@="powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"ps1Path\" -Folder \"%1\" -IconIndex 1 -IconPath \"iclPath\""

